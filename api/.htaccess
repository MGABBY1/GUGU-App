# Pass Authorization header through to PHP (XAMPP/Apache often strips it)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# CORS preflight
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Gugu-Token"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
